# Spotify Developer App (https://developer.spotify.com/dashboard)
# Ohne diese Werte läuft die App trotzdem – dann wird Deezer für Suche
# und Metadaten verwendet (kein API-Key nötig).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Ordner, in den Exporte zusätzlich direkt gespeichert werden,
# z. B. C:\Users\DeinName\Pictures\Poster
POSTER_OUTPUT_DIR=
